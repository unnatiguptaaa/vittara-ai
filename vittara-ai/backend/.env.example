# Server
PORT=5000


# Google Gemini API key — required for live AI explanations across Loan
# Assistant, Insurance Assistant, AI Chat, Smart Comparison, Jargon
# Translator, and Document Analyzer. Without it, every endpoint still works
# end-to-end using built-in demo-mode fallback text.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional — only used if you want to persist chat/summary history.
# Leave unset to run in demo mode with no database.
MONGO_URI=mongodb+srv://unnatig521_db_user:unnati1234@cluster0.tyybjpz.mongodb.net/?appName=Cluster0
